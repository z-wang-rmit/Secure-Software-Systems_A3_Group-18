# Copy to .env, or run `python scripts/setup_dev.py` to create it with random values.
# Never commit .env.

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# MySQL (used by Docker). Locally without Docker, the app uses SQLite instead.
DB_USER=evote_app
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# 32-byte key (base64) for encrypting electoral roll details (R06)
ROLL_KEY=change-me

# Password for every demo account (voter1, staff1, auditor1, ...)
SEED_PASSWORD=change-me
